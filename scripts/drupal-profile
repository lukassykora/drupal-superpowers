#!/usr/bin/env bash
# drupal-profile: static Project Capability Profile as JSON (see docs/architecture.md §5.1).
# Never executes Drush, Composer, or PHP code from the project; safe in any environment.
#
#   drupal-profile [<dir>] [--no-cache] [--summary]
#
set -u
. "$(dirname "$0")/lib/common.sh"

DIR="."; NOCACHE=0; SUMMARY=0
for a in "$@"; do case "$a" in --no-cache) NOCACHE=1;; --summary) SUMMARY=1;; -*) ;; *) DIR=$a;; esac; done

read -r KIND ROOT <<<"$(dsp_find_root "$DIR")"

if [ "$KIND" = "none" ]; then
  printf '{"schema":1,"generated_at":%s,"composer_root":null,"project_kind":"unknown","drupal":null,"note":%s}\n' "$(dsp_jstr "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" "$(dsp_jstr "no Drupal project found walking up from $(cd "$DIR" && pwd)")"
  exit 0
fi

# ---- cache
DOCROOT_GUESS=$(dsp_find_docroot "$ROOT")
DATA=$(dsp_data_dir)
KEY=$(printf '%s' "$ROOT" | (dsp_have shasum && shasum | cut -c1-12 || cksum | cut -d' ' -f1))
CACHE="$DATA/profiles/$KEY.json"
STAMP=""
if stat -c '%Y' / >/dev/null 2>&1; then mt() { stat -c '%Y' "$1"; }; else mt() { stat -f '%m' "$1"; }; fi
for f in composer.lock composer.json .ddev/config.yaml .lando.yml .mcp.json; do [ -f "$ROOT/$f" ] && STAMP="$STAMP $(mt "$ROOT/$f" 2>/dev/null)"; done
for d in "$DOCROOT_GUESS/modules/custom" "$DOCROOT_GUESS/themes/custom"; do [ -d "$ROOT/$d" ] && STAMP="$STAMP $(ls "$ROOT/$d" | wc -l | tr -d ' ')"; done
if [ $NOCACHE -eq 0 ] && [ -f "$CACHE" ] && [ -f "$CACHE.stamp" ] && [ "$(cat "$CACHE.stamp")" = "$STAMP" ]; then
  if [ $SUMMARY -eq 1 ]; then "$0" "$DIR" --summary --no-cache; else cat "$CACHE"; fi
  exit 0
fi

CJ="$ROOT/composer.json"; CL="$ROOT/composer.lock"
DOCROOT=$(dsp_find_docroot "$ROOT")
D="$ROOT/$DOCROOT"; [ "$DOCROOT" = "." ] && D="$ROOT"

# ---- versions from composer.lock (name version per line)
LOCKV=""; [ -f "$CL" ] && LOCKV=$(dsp_json lockversions "$CL" || true)
lockver() { printf '%s\n' "$LOCKV" | awk -v n="$1" '$1==n {print $2; exit}'; }
haslock() { [ -n "$(lockver "$1")" ]; }

DRUPAL_VERSION=""; DRUPAL_SOURCE=""
if [ "$KIND" = "d7" ]; then
  DRUPAL_VERSION=$(grep -o "define('VERSION', '[^']*')" "$ROOT/includes/bootstrap.inc" | sed "s/.*'\([^']*\)')/\1/"); DRUPAL_SOURCE="bootstrap.inc"
else
  DRUPAL_VERSION=$(lockver drupal/core); [ -n "$DRUPAL_VERSION" ] && DRUPAL_SOURCE="composer.lock"
  if [ -z "$DRUPAL_VERSION" ] && [ -f "$D/core/lib/Drupal.php" ]; then
    DRUPAL_VERSION=$(grep -o "const VERSION = '[^']*'" "$D/core/lib/Drupal.php" | sed "s/.*'\([^']*\)'/\1/"); DRUPAL_SOURCE="Drupal.php"
  fi
  if [ -z "$DRUPAL_VERSION" ] && [ -f "$CJ" ]; then
    c=$(dsp_json get "$CJ" require.drupal/core-recommended); [ -z "$c" ] && c=$(dsp_json get "$CJ" require.drupal/core)
    [ -z "$c" ] && c=$(dsp_json get "$CJ" require.drupal/core-composer-scaffold)
    if [ -n "$c" ]; then v=$(echo "$c" | grep -o '[0-9]\+\(\.[0-9]\+\)*' | head -1); [ -n "$v" ] && { DRUPAL_VERSION=$v; DRUPAL_SOURCE="composer.json-constraint"; }; fi
  fi
fi
MAJOR=${DRUPAL_VERSION#dev-}; MAJOR=${MAJOR%%.*}; MINOR=""; case "$DRUPAL_VERSION" in *.*) MINOR=$(echo "${DRUPAL_VERSION#dev-}" | cut -d. -f2 | grep -o '^[0-9]*');; esac
case "$MAJOR" in ''|*[!0-9]*) MAJOR="";; esac; case "$MINOR" in ''|*[!0-9]*) MINOR="";; esac

# ---- router
ROUTER='{"class":"unknown","eol_date":null,"note":"no version detected"}'
if [ -n "$DRUPAL_VERSION" ]; then ROUTER=$("$(dirname "$0")/drupal-facts" class "$DRUPAL_VERSION" --json 2>/dev/null) || ROUTER=""; fi
[ -n "$ROUTER" ] || ROUTER='{"class":"unknown","eol_date":null,"note":"router unavailable (no JSON engine or unknown version)"}'

# ---- distribution
DIST="core"
if [ -f "$CJ" ] && grep -q '"drupal/cms"' "$CJ" 2>/dev/null; then DIST="drupal-cms"; fi
DIST_EXT=""   # resolved after CONFIG_SYNC/SYNC_ABS below

# ---- project kind
PKIND="site"
if [ "$KIND" = "d7" ]; then PKIND="site"
elif [ "$KIND" = "core" ]; then PKIND="core"
elif [ -f "$CJ" ] && grep -Eq '"type": *"drupal-(module|theme|profile|custom-module)"' "$CJ"; then
  PKIND="custom-module"; grep -q '"name": *"drupal/' "$CJ" && [ -f "$ROOT/.gitlab-ci.yml" ] && PKIND="contrib-module"
fi

# ---- php
PHP_CONSTRAINT=""; [ -f "$CJ" ] && PHP_CONSTRAINT=$(dsp_json get "$CJ" require.php)
[ -z "$PHP_CONSTRAINT" ] && [ -f "$CL" ] && PHP_CONSTRAINT=$(dsp_json get "$CL" platform.php)
[ -z "$PHP_CONSTRAINT" ] && [ -f "$D/core/composer.json" ] && PHP_CONSTRAINT="$(dsp_json get "$D/core/composer.json" require.php) (from core/composer.json)"
PHP_LOCAL=""; dsp_have php && PHP_LOCAL=$(php -r 'echo PHP_VERSION;' 2>/dev/null || true)

# ---- paths
list_dirs_with_info() { # $1 base
  [ -d "$1" ] || return 0
  find "$1" -maxdepth 3 -name '*.info.yml' 2>/dev/null | while read -r f; do dirname "$f"; done | sort -u
}
CUSTOM_MODULE_DIRS=""; for c in "$D/modules/custom" "$D/modules" "$ROOT/modules/custom"; do [ -d "$c" ] && CUSTOM_MODULE_DIRS="$c"; [ -d "$D/modules/custom" ] && break; done
CUSTOM_MODULES=$( [ -d "$D/modules/custom" ] && list_dirs_with_info "$D/modules/custom" | xargs -n1 basename 2>/dev/null || true)
[ "$KIND" = "d7" ] && CUSTOM_MODULES=$(find "$ROOT/sites/all/modules/custom" "$ROOT/sites/all/modules" -maxdepth 2 -name '*.info' 2>/dev/null | xargs -n1 dirname 2>/dev/null | xargs -n1 basename 2>/dev/null | sort -u || true)
if [ "$PKIND" = "custom-module" ] || [ "$PKIND" = "contrib-module" ]; then CUSTOM_MODULES=$(basename "$ROOT"); fi
CUSTOM_THEMES=$( [ -d "$D/themes/custom" ] && list_dirs_with_info "$D/themes/custom" | xargs -n1 basename 2>/dev/null || true)
PROFILES=$( [ -d "$D/profiles/custom" ] && list_dirs_with_info "$D/profiles/custom" | xargs -n1 basename 2>/dev/null || true)
RECIPES=$( [ -d "$ROOT/recipes" ] && find "$ROOT/recipes" -maxdepth 2 -name recipe.yml 2>/dev/null | xargs -n1 dirname 2>/dev/null | xargs -n1 basename 2>/dev/null || true)
CONFIG_SYNC=""
if [ -f "$D/sites/default/settings.php" ]; then CONFIG_SYNC=$(grep -v '^ *\(#\|//\)' "$D/sites/default/settings.php" 2>/dev/null | grep -o "config_sync_directory'\] *= *'[^']*'" | head -1 | sed "s/.*'\([^']*\)'$/\1/"); fi
[ -z "$CONFIG_SYNC" ] && [ -f "$D/sites/default/settings.php" ] && CONFIG_SYNC=$(grep -v '^ *\(#\|//\)' "$D/sites/default/settings.php" | grep -o "config_sync_directory'\] *= *[^;]*" | head -1 | sed "s/.*= *//")
[ -z "$CONFIG_SYNC" ] && [ -d "$ROOT/config/sync" ] && CONFIG_SYNC="config/sync"
case "$CONFIG_SYNC" in /*) SYNC_ABS=$CONFIG_SYNC;; "") SYNC_ABS="";; *) SYNC_ABS="$D/$CONFIG_SYNC";; esac   # Drupal resolves relative sync paths against the docroot
for cand in "${SYNC_ABS:-}/core.extension.yml" "$ROOT/config/sync/core.extension.yml"; do [ -n "$cand" ] && [ -f "$cand" ] && { DIST_EXT=$cand; break; }; done
if [ -n "$DIST_EXT" ]; then p=$(grep '^profile:' "$DIST_EXT" | awk '{print $2}'); [ -n "$p" ] && [ "$p" != "minimal" ] && [ "$p" != "standard" ] && DIST="profile:$p"; fi
CONFIG_SPLIT=false; { haslock drupal/config_split || { [ -n "$SYNC_ABS" ] && ls "$SYNC_ABS"/config_split.*.yml >/dev/null 2>&1; }; } && CONFIG_SPLIT=true

# ---- modules
CONTRIB=$(printf '%s\n' "$LOCKV" | awk '$1 ~ /^drupal\// && $1 !~ /^drupal\/(core|coder|cms$|recommended-project|legacy-project)/ {sub("drupal/","",$1); print $1}' | sort)
PATCHED=""; [ -f "$CJ" ] && PATCHED=$(dsp_json keys "$CJ" extra.patches || true)

# ---- features
EXT="${SYNC_ABS:+$SYNC_ABS/core.extension.yml}"; [ -n "$EXT" ] && [ -f "$EXT" ] || EXT=""
extmod() { [ -n "$EXT" ] && grep -q "^  $1:" "$EXT"; }
MULTISITE=false; [ -f "$D/sites/sites.php" ] && MULTISITE=true
MULTILINGUAL=false; { extmod language || extmod content_translation; } && MULTILINGUAL=true
MODERATION=false; extmod content_moderation && MODERATION=true
WORKSPACES=false; extmod workspaces && WORKSPACES=true
SEARCH="none"; haslock drupal/search_api_solr && SEARCH="search_api_solr"; [ "$SEARCH" = none ] && haslock drupal/search_api && SEARCH="search_api"; [ "$SEARCH" = none ] && extmod search && SEARCH="core"
QUEUE="core"; haslock drupal/advancedqueue && QUEUE="advancedqueue"
CRON="core"; haslock drupal/ultimate_cron && CRON="ultimate_cron"
DBTYPE=""; for sp in "$D/sites/default/settings.php" "$D/sites/default/settings.local.php" "$D/sites/default/settings.ddev.php"; do [ -f "$sp" ] || continue; v=$(grep -v '^ *\(\*\|#\|//\|/\*\)' "$sp" 2>/dev/null | grep -o "'driver' *=> *'[a-z]*'" | tail -1 | sed "s/.*'\([a-z]*\)'$/\1/"); [ -n "$v" ] && DBTYPE=$v; done; [ -z "$DBTYPE" ] && DBTYPE="unknown"

# ---- quality
first_existing() { for f in "$@"; do [ -e "$ROOT/$f" ] && { echo "$f"; return; }; done; }
PHPCS_CFG=$(first_existing phpcs.xml phpcs.xml.dist .phpcs.xml .phpcs.xml.dist)
PHPSTAN_CFG=$(first_existing phpstan.neon phpstan.neon.dist phpstan.dist.neon)
PHPUNIT_CFG=$(first_existing phpunit.xml phpunit.xml.dist "$DOCROOT/core/phpunit.xml" "$DOCROOT/core/phpunit.xml.dist")
SCRIPTS=""; [ -f "$CJ" ] && SCRIPTS=$(dsp_json keys "$CJ" scripts || true)
CI="none"; [ -f "$ROOT/.gitlab-ci.yml" ] && CI="gitlab"; [ -d "$ROOT/.github/workflows" ] && CI="github"; [ -f "$ROOT/bitbucket-pipelines.yml" ] && CI="bitbucket"
ESLINT=false; ls "$ROOT"/.eslintrc* "$ROOT"/eslint.config.* >/dev/null 2>&1 && ESLINT=true
STYLELINT=false; ls "$ROOT"/.stylelintrc* "$ROOT"/stylelint.config.* >/dev/null 2>&1 && STYLELINT=true
MAKE=""; [ -f "$ROOT/Makefile" ] && MAKE="Makefile"; [ -f "$ROOT/Taskfile.yml" ] && MAKE="Taskfile.yml"

# ---- frontend
# Drupal themes usually carry their own package.json, so look in the theme directories too.
FE_DIRS="$ROOT"; for t in "$D"/themes/custom/*/; do [ -d "$t" ] && FE_DIRS="$FE_DIRS ${t%/}"; done
PM="none"; BUILD="none"; CSS_FW="none"; CSS_FW_VER=""; FE_ROOT=""
for fd in $FE_DIRS; do
  [ -f "$fd/package.json" ] || continue
  [ -z "$FE_ROOT" ] && FE_ROOT="$fd"
  [ "$PM" = "none" ] && PM="npm"
  [ -f "$fd/yarn.lock" ] && PM="yarn"; [ -f "$fd/pnpm-lock.yaml" ] && PM="pnpm"
  ls "$fd"/vite.config.* >/dev/null 2>&1 && BUILD="vite"
  ls "$fd"/webpack.config.* >/dev/null 2>&1 && [ "$BUILD" = "none" ] && BUILD="webpack"
  if grep -q '"tailwindcss"' "$fd/package.json" 2>/dev/null; then
    CSS_FW="tailwind"
    CSS_FW_VER=$(sed -n 's/.*"tailwindcss" *: *"\([^"]*\)".*/\1/p' "$fd/package.json" | head -1)
    [ -z "$FE_ROOT" ] && FE_ROOT="$fd"
  elif [ "$CSS_FW" = "none" ] && grep -q '"bootstrap"' "$fd/package.json" 2>/dev/null; then
    CSS_FW="bootstrap"
    CSS_FW_VER=$(sed -n 's/.*"bootstrap" *: *"\([^"]*\)".*/\1/p' "$fd/package.json" | head -1)
  fi
done
# Tailwind can also be driven by the standalone CLI with no package.json at all.
if [ "$CSS_FW" = "none" ]; then
  if ls "$D"/themes/custom/*/tailwind.config.* >/dev/null 2>&1 || ls "$ROOT"/tailwind.config.* >/dev/null 2>&1; then CSS_FW="tailwind"
  elif grep -rlq '@import *"tailwindcss"' "$D"/themes/custom/*/ 2>/dev/null; then CSS_FW="tailwind"; fi
fi
# v4 is CSS-first (@import "tailwindcss"); v3 needs a JS config file and @tailwind directives.
CSS_FW_STYLE=""
if [ "$CSS_FW" = "tailwind" ]; then
  if grep -rlq '@import *"tailwindcss"' "$D"/themes/custom/*/ 2>/dev/null; then CSS_FW_STYLE="css-first(v4)"
  elif ls "$D"/themes/custom/*/tailwind.config.* >/dev/null 2>&1 || ls "$ROOT"/tailwind.config.* >/dev/null 2>&1; then CSS_FW_STYLE="js-config(v3)"; fi
fi
[ "$PM" = "none" ] && [ -f "$ROOT/yarn.lock" ] && PM="yarn"
SDC=false; ls -d "$D"/themes/custom/*/components >/dev/null 2>&1 && SDC=true

# ---- testing frameworks
TF=""
[ -n "$PHPUNIT_CFG" ] || haslock phpunit/phpunit && TF="phpunit"
haslock weitzman/drupal-test-traits && TF="$TF dtt"
{ [ -f "$ROOT/behat.yml" ] || haslock drupal/drupal-extension; } && TF="$TF behat"
ls "$ROOT"/cypress.config.* >/dev/null 2>&1 && TF="$TF cypress"
ls "$ROOT"/playwright.config.* >/dev/null 2>&1 && TF="$TF playwright"
[ -f "$ROOT/nightwatch.conf.js" ] && TF="$TF nightwatch"

# ---- mcp + agent skills
MCP_SERVERS=""; MCP_HINTS=""
if [ -f "$ROOT/.mcp.json" ]; then
  MCP_SERVERS=$(dsp_json keys "$ROOT/.mcp.json" mcpServers || true)
  for pat in mcp-tools:serve mcp:server drush-mcp mcp-server-drupal ddev-mcp _mcp_tools /mcp/post mo-mcp-server mcp-stub; do grep -q "$pat" "$ROOT/.mcp.json" && MCP_HINTS="$MCP_HINTS $pat"; done
fi
for m in mcp_tools mcp_server mcp project_context_connector drush_webmaster; do haslock "drupal/$m" && MCP_HINTS="$MCP_HINTS composer:drupal/$m"; done
AS_PROJECT=$(ls -d "$ROOT"/.agents/skills/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null || true)
AS_VENDOR=$(find "$ROOT/vendor" -maxdepth 4 -type d -path '*/.agents/skills/*' 2>/dev/null | head -20 || true)

# ---- deployment hints
DEPLOY=""; DEPLOY_TMP=$(mktemp)
for f in "$ROOT/.gitlab-ci.yml" "$ROOT"/.github/workflows/*.yml "$ROOT/Makefile" "$ROOT/Taskfile.yml" "$ROOT/composer.json"; do
  [ -f "$f" ] || continue
  grep -Eo 'drush (deploy|updb|cim|config:import|cr)( -y)?' "$f" 2>/dev/null | sort -u | while read -r h; do echo "$(basename "$f"): $h"; done
done | sort -u > "$DEPLOY_TMP" 2>/dev/null || true
DEPLOY=$(cat "$DEPLOY_TMP" 2>/dev/null || true); rm -f "$DEPLOY_TMP"

# ---- emit
J=$(cat <<EOF
{
  "schema": 1,
  "generated_at": $(dsp_jstr "$(date -u +%Y-%m-%dT%H:%M:%SZ)"),
  "composer_root": $(dsp_jstr "$ROOT"),
  "docroot": $(dsp_jstr "$DOCROOT"),
  "project_kind": $(dsp_jstr "$PKIND"),
  "drupal": {"version": $(dsp_jval "$DRUPAL_VERSION"), "major": ${MAJOR:-null}, "minor": ${MINOR:-null}, "source": $(dsp_jval "$DRUPAL_SOURCE"), "distribution": $(dsp_jstr "$DIST")},
  "router": $ROUTER,
  "php": {"constraint": $(dsp_jval "$PHP_CONSTRAINT"), "local_cli": $(dsp_jval "$PHP_LOCAL")},
  "packages": {"drush": $(dsp_jval "$(lockver drush/drush)"), "symfony_http_kernel": $(dsp_jval "$(lockver symfony/http-kernel)"), "phpunit": $(dsp_jval "$(lockver phpunit/phpunit)"), "coder": $(dsp_jval "$(lockver drupal/coder)"), "phpstan_drupal": $(dsp_jval "$(lockver mglaman/phpstan-drupal)"), "drupal_rector": $(dsp_jval "$(lockver palantirnet/drupal-rector)"), "upgrade_status": $(dsp_jval "$(lockver drupal/upgrade_status)"), "core_dev": $( haslock drupal/core-dev && echo true || echo false ), "composer_patches": $(dsp_jval "$(lockver cweagans/composer-patches)")},
  "paths": {"custom_modules": $(printf '%s\n' "${CUSTOM_MODULE_DIRS#"$ROOT/"}" | dsp_jarr), "custom_themes": $( [ -d "$D/themes/custom" ] && printf '%s\n' "$DOCROOT/themes/custom" | dsp_jarr || echo '[]'), "profiles": $(printf '%s\n' "$PROFILES" | dsp_jarr), "recipes": $(printf '%s\n' "$RECIPES" | dsp_jarr), "config_sync": $(dsp_jval "$CONFIG_SYNC"), "config_split": $CONFIG_SPLIT},
  "modules": {"contrib": $(printf '%s\n' "$CONTRIB" | dsp_jarr), "custom": $(printf '%s\n' "$CUSTOM_MODULES" | dsp_jarr), "patched": $(printf '%s\n' "$PATCHED" | dsp_jarr)},
  "features": {"multisite": $MULTISITE, "multilingual": $MULTILINGUAL, "content_moderation": $MODERATION, "workspaces": $WORKSPACES, "search": $(dsp_jstr "$SEARCH"), "queue": $(dsp_jstr "$QUEUE"), "cron": $(dsp_jstr "$CRON"), "database": $(dsp_jstr "$DBTYPE")},
  "quality": {"phpcs_config": $(dsp_jval "$PHPCS_CFG"), "phpstan_config": $(dsp_jval "$PHPSTAN_CFG"), "phpunit_config": $(dsp_jval "$PHPUNIT_CFG"), "composer_scripts": $(printf '%s\n' "$SCRIPTS" | dsp_jarr), "task_runner": $(dsp_jval "$MAKE"), "ci": $(dsp_jstr "$CI"), "eslint": $ESLINT, "stylelint": $STYLELINT},
  "frontend": {"package_manager": $(dsp_jstr "$PM"), "build": $(dsp_jstr "$BUILD"), "sdc": $SDC,
               "root": $(dsp_jstr "${FE_ROOT#$ROOT/}"), "css_framework": $(dsp_jstr "$CSS_FW"),
               "css_framework_version": $(dsp_jstr "$CSS_FW_VER"), "css_framework_style": $(dsp_jstr "$CSS_FW_STYLE")},
  "testing_frameworks": $(printf '%s\n' $TF | dsp_jarr),
  "mcp": {"configured_servers": $(printf '%s\n' "$MCP_SERVERS" | dsp_jarr), "fingerprint_hints": $(printf '%s\n' $MCP_HINTS | dsp_jarr)},
  "agent_skills": {"project": $(printf '%s\n' "$AS_PROJECT" | dsp_jarr), "vendor": $(printf '%s\n' "$AS_VENDOR" | dsp_jarr)},
  "deployment": {"hints": $(printf '%s\n' "$DEPLOY" | dsp_jarr)}
}
EOF
)
mkdir -p "$(dirname "$CACHE")" 2>/dev/null && { printf '%s\n' "$J" > "$CACHE"; printf '%s' "$STAMP" > "$CACHE.stamp"; } || true

if [ $SUMMARY -eq 1 ]; then
  RC=$(printf '%s' "$ROUTER" | sed 's/.*"class":"\([^"]*\)".*/\1/'); RN=$(printf '%s' "$ROUTER" | sed -n 's/.*"note":"\([^"]*\)".*/\1/p')
  printf 'Drupal %s (%s, %s) · PHP %s · kind %s · docroot %s\n' "${DRUPAL_VERSION:-unknown}" "$RC" "$DRUPAL_SOURCE" "${PHP_CONSTRAINT:-?}" "$PKIND" "$DOCROOT"
  printf 'custom modules: %s\n' "$(echo $CUSTOM_MODULES | tr '\n' ' ')"
  printf 'config: %s%s · ci: %s · tests: %s · lint: %s%s\n' "${CONFIG_SYNC:-none}" "$( $CONFIG_SPLIT && echo ' (config_split)')" "$CI" "${TF:-none}" "${PHPCS_CFG:-none}" "${PHPSTAN_CFG:+ + $PHPSTAN_CFG}"
  [ -n "$SCRIPTS" ] && printf 'composer scripts: %s\n' "$(echo $SCRIPTS | tr '\n' ' ')"
  [ "$CSS_FW" != "none" ] && printf 'frontend: %s %s %s · pm %s · build %s%s\n' "$CSS_FW" "$CSS_FW_VER" "$CSS_FW_STYLE" "$PM" "$BUILD" "$( $SDC && echo ' · sdc')"
  if [ -n "$(echo $MCP_HINTS $MCP_SERVERS)" ]; then printf 'mcp servers: %s · hints:%s\n' "$(echo $MCP_SERVERS)" "$(echo " $MCP_HINTS")"; fi
  [ -n "$RN" ] && printf 'router note: %s\n' "$RN"
else
  printf '%s\n' "$J"
fi
exit 0
